# wahl-strassenbau.de: Apache-Konfiguration (mod_rewrite, mod_headers, mod_expires, mod_deflate)
# Hinweis: Nur `python3 build.py` erzeugt die Seiten; auf den Server gehören die fertigen Dateien, nicht src/, _refs/ oder build.py.

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# HTTPS und genau ein Domainname (www), ein einziger 301-Sprung
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.wahl-strassenbau.de%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} !^www\.wahl-strassenbau\.de$ [NC]
  RewriteRule ^ https://www.wahl-strassenbau.de%{REQUEST_URI} [L,R=301]

  # Interne Dateien nie ausliefern (ADR-0001: server/ und storage/ zusätzlich mit eigener .htaccess «Require all denied»)
  RewriteRule ^(src|_refs|_bentotest|docs|tests|server|storage|cloudflare|\.git|\.agents|\.claude)(/|$) - [R=404,L]
</IfModule>
<FilesMatch "(^\.|\.(md|py|log|json|sqlite|sqlite3|sqlite-wal|sqlite-shm|sqlite-journal|lock|sh)$|^build\.py$|^config\.local\.php$)">
  Require all denied
</FilesMatch>
# Ausnahme: kontakt.php bleibt erreichbar; Formular-Testlog nie
<FilesMatch "^kontakt-test\.log$">
  Require all denied
</FilesMatch>

# MIME-Typen
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Zwischenspeicher: HTML immer prüfen, CSS/JS einen Tag, Bilder und Schriften ein Jahr
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Sicherheits-Header (keine externen Ressourcen: alles von der eigenen Domain)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>
